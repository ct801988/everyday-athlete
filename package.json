{
  "name": "everyday-athlete-foundation",
  "version": "0.5.0-m1-candidate",
  "description": "No-login local-first synthetic software preview; not approved training guidance",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "dev": "vite",
    "api": "node --import tsx server/index.ts",
    "build": "vite build && node scripts/build-offline.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:browser": "playwright test",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:native": "node scripts/start-db.mjs",
    "format": "prettier --write src server scripts tests *.ts *.js *.json",
    "format:check": "prettier --check src server scripts tests *.ts *.js *.json",
    "browser:prepare": "node scripts/prepare-browser.mjs",
    "db:backup": "node --import tsx scripts/backup.ts",
    "db:restore": "node --import tsx scripts/restore.ts",
    "start": "vite --host 127.0.0.1",
    "start:lab": "node scripts/start-lab.mjs",
    "demo": "npm run build && vite preview --host 127.0.0.1 --port 5175 --strictPort",
    "test:local": "playwright test --config playwright.m1.config.ts",
    "build:test": "vite build --config vite.local-test.config.ts && node scripts/build-offline.mjs .data/local-test-build",
    "build:preview": "npm run build && node scripts/build-preview.mjs",
    "test:preview": "node scripts/test-preview.mjs",
    "build:dashboard": "npm run build:preview && node scripts/build-dashboard-preview.mjs",
    "test:dashboard": "EA_PREVIEW_PACKAGE=dashboard node scripts/test-preview.mjs",
    "build:pages": "vite build --config vite.pages.config.ts && node --import tsx scripts/build-pages.ts",
    "test:pages": "node --import tsx scripts/test-pages.ts",
    "test:m1": "playwright test --config playwright.m1.config.ts",
    "test:m1:pages": "playwright test --config playwright.m1-pages.config.ts",
    "test:local:historical": "playwright test --config playwright.local.config.ts acceptance.spec.ts mobile-timer.spec.ts"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sparticuz/chromium": "153.0.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
